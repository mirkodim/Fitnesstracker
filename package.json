{
  "name": "strichliste",
  "version": "1.0.0",
  "private": true,
  "description": "Trainings-Strichliste: installierbare Offline-App (PWA) für GitHub Pages",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check-site.mjs _site",
    "icons": "node tools/make-icons.mjs",
    "sheets": "node tools/contact-sheet.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "sharp": "^0.34.0"
  }
}
